  "trajectory": {
    "seeds": [11, 23],
    "max_new_tokens": 24,
    "chunk_tokens": 6,
    "do_sample": true,
    "temperature": 0.8
  },
  "atlas": {
    "center_count": 32,
    "center_selection": "first 32 calibration coordinates after frozen path-hash ordering"
  },
  "primary_metrics": [
    "heldout_coordinate_rmse",
    "heldout_canonical_cosine",
    "nearest_quasar_agreement",
    "shuffled_coordinate_rmse",
    "atlas_coverage",
    "transition_count"
  ],
  "gate": {
    "require_shuffled_worse_than_paired": true,
    "notes": "This manifest freezes identity and collection policy only. It does not predeclare a success threshold not already present in protocol.md. Results remain descriptive until a threshold addendum is frozen before inspection."
  }
}
