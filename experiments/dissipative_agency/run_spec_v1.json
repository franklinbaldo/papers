  "agency_certificate": {
    "definition": "paired counterfactual pruning of reachable future volume",
    "paired_noise_required": true,
    "controlled_condition": "ReachableVolume(step(members, some(control), xi), some(control), xi)",
    "free_condition": "ReachableVolume(step(members, none, xi), none, xi)",
    "success_relation": "controlled < free",
    "crystal_guard": "passive coherence without strict counterfactual future-volume contraction does not count as agency"
  },
  "multirate_clocks": {
    "base_dt": 0.005,
    "level_multipliers": {
      "0": 1,
      "1": 2,
      "2": 4,
      "3": 8
    },
    "status": "engineering baseline, not biological law"
  },
  "metabolism": {
    "e0_endowment": 10.0,
    "kappa_base": 0.05,
    "kappa_action": 0.02,
    "eta_harvest": 0.12
  },
  "universes": [
    {
      "id": "A_passive",
      "controller": null,
      "recursive_promotion": false
    },
    {
      "id": "B_detection_only",
      "controller": "null_passive_cluster",
      "recursive_promotion": false
    },
    {
      "id": "C_shallow",
      "controller": "malecns",
      "max_controller_level": 1,
      "recursive_promotion": false
    },
    {
      "id": "D_recursive",
      "controller": "malecns",
      "recursive_promotion": true
    }
