# Python bytecode and tool caches — build artifacts must never be tracked
# (a cpython-3.13 __pycache__/ tree was accidentally committed with the
# Semantic Atlas experiment in 0178214; see .gitignore introduction commit).
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Credentials. The repo has no allowlist, so a key dropped here would otherwise
# be one `git add -A` away from being published.
.env
.env.*
!.env.example
.envrc
